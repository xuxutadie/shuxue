          ]
        },
        {
          "cue": "l3",
          "text": "先问自己：是把现有数量平均分开，还是让两个间隔往前走到一起？名称由数量关系决定。",
          "scene": "s4",
          "index": 3,
          "file": "assets/voice-xiaoxiao/s4-03.mp3",
          "duration": 9.672,
          "voice": "zh-CN-XiaoxiaoNeural",
          "rate": "-8%",
