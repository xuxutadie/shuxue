          "captions": [
            {
              "start": 0.75,
              "duration": 2.7668477,
              "text": "先读清两人的出发时间。"
            },
            {
              "start": 3.5168477,
              "duration": 3.5733695,
              "text": "小明先走五分钟，小华才出发。"
            },
            {
              "start": 7.0902172000000006,
              "duration": 6.471782800000001,
              "text": "题目问的是小华出发以后几分钟，而不是从小明出发算起。"
            }
          ]
        },
        {
          "cue": "l1",
          "text": "两个人从同一地点、同一方向前进，而且都不停留。我们把小华出发的时刻设为追赶计时的零点。",
          "scene": "s1",
          "index": 1,
          "file": "assets/voice-xiaoxiao/s1-01.mp3",
